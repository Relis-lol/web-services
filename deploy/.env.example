# Saveroq Studio — Umgebungsvariablen
#
# Diese Datei ist die Vorlage. Die echte Datei heisst `.env`, liegt daneben
# und gehoert NICHT ins Repository (siehe .gitignore).
#
# Kopieren mit:  cp deploy/.env.example deploy/.env

# Token des Cloudflare-Tunnels fuer studio.saveroq.com.
#
# Zu finden im Cloudflare-Dashboard unter
#   Zero Trust → Networks → Tunnels → <Tunnel> → Configure → Install connector
# im angezeigten Befehl hinter `--token`.
#
# Solange der Wert leer ist, startet nur der Tunnel-Container in einer
# Neustartschleife. Der Webserver laeuft weiter und ist im Docker-Netz
# erreichbar — praktisch, um das Deployment vor dem Tunnel zu pruefen.
#
# WICHTIG: Das Token ist ein Geheimnis. Es gehoert ausschliesslich in diese
# Datei auf dem Server, niemals ins Repository.
CLOUDFLARE_TUNNEL_TOKEN=


# ===========================================================================
# SMTP fuer das Kontaktformular
# ===========================================================================
# Ohne diese Angaben nimmt das Formular zwar Eingaben entgegen, meldet dem
# Besucher aber ehrlich einen Fehler. Es wird NIE ein Versand vorgetaeuscht.
#
# Pflicht sind SMTP_HOST, SMTP_PORT, SMTP_FROM und CONTACT_TO.
# Benutzername und Passwort sind optional — manche Relays im eigenen Netz
# nehmen ohne Anmeldung an.

# Versendet wird ueber den vorhandenen Brevo-Relay des Servers. Host, Port,
# Benutzer und Schluessel sind serverseitig bereits eingetragen — sie werden
# aus dem WIVOKO-Stack wiederverwendet und stehen NICHT in diesem Repository.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Der Absender ist bei Brevo freigegeben. Der Wert ist kein Geheimnis; die
# Zugangsdaten bleiben ausschliesslich in deploy/.env auf dem Server.
SMTP_FROM=studio@saveroq.com

# Anzeigename des Absenders im Postfach.
SMTP_FROM_NAME=Saveroq Studio

# Interne Zieladresse der Anfragen. Der Wert wird nicht oeffentlich
# ausgeliefert und steht ausschliesslich in deploy/.env auf dem Server.
CONTACT_TO=

# starttls (Standard, Port 587) | ssl (Port 465) | none (nur fuer Tests)
SMTP_SECURITY=starttls

# ---------------------------------------------------------------------------
# Ratenbegrenzung (optional, sinnvolle Vorgaben sind eingebaut)
# ---------------------------------------------------------------------------
# RATE_LIMIT_MAX=10           Anfragen je IP
# RATE_LIMIT_WINDOW=900       innerhalb dieser Sekunden (900 = 15 Minuten)
# RATE_LIMIT_GLOBAL_MAX=60    Obergrenze ueber alle IPs im selben Fenster
